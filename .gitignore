# Raw and interim data are reproducible from `make data` and are not committed.
# data/processed/ IS committed when under 50MB (CLAUDE.md §3).
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep

# Build bookkeeping
.stamps/*
!.stamps/.gitkeep
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# OS / editor
.DS_Store
.vscode/
.idea/

# Web edition
web/node_modules/

# index.html is a BUILD ARTEFACT, not source: `gcg.web.inject` rewrites it in
# place on every `make web`, substituting statistics and regenerating the data
# tables as single long lines. It is committed (it is the deliverable) but must
# never be run through a formatter — Prettier silently deleted content from it
# once, at four points, each immediately after a data-key span it had broken
# across lines. See .prettierignore.

# Review captures: 42MB of PNGs, regenerated by `make web`.
web/test/screens/

# Build staging for the published site; reproduced by `make web-deploy`.
build/
web/test/screens-live/
